# Copy this file to ".env" in the PROJECT ROOT (same folder as server.js). Never commit .env.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET=your-sandbox-secret

# --- AI assistant (free) ---------------------------------------------------
# Get a free key from Google AI Studio (aistudio.google.com/apikey) and paste it here.
# Leave blank to run without AI: the basic voice parser is used instead.
AI_API_KEY=

# Defaults (Google Gemini's free tier via its OpenAI-compatible endpoint). Change only to switch provider.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
#
# Speed: AI_TIMEOUT_MS (default 12000) is how long to wait before falling back to the basic parser.
# AI_REASONING_EFFORT (default "low" for Gemini) limits model "thinking"; set it blank to turn that off.
#
# Any provider with an OpenAI-style /chat/completions API and tool calling works, e.g.:
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=<a Groq model that supports tool use>
#   Ollama (local, no key): AI_BASE_URL=http://localhost:11434/v1  AI_API_KEY=ollama  AI_MODEL=<a tool-capable model>

# --- Webhooks (optional, see README) ---------------------------------------
# Webhook ID shown by PayPal after you add https://<public-url>/webhooks/paypal to your sandbox app.
PAYPAL_WEBHOOK_ID=
# Demo only: 1 = dashboard gets "simulate a webhook" buttons (entries are labelled Simulated). Keep off when deployed.
ENABLE_SIMULATOR=
# Invoices per minute per IP (each one sends an email). Default 10.
# INVOICES_PER_MIN=10

PORT=3001
APP_PIN=1234
MAX_AMOUNT=500
